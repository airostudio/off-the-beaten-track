# Flight provider (Duffel, Amadeus, etc). Leave blank to use the built-in
# mock provider — the app is fully usable without this.
FLIGHT_PROVIDER_API_KEY=

# Stripe (subscriptions/billing). Leave blank to disable checkout; the rest
# of the app still runs.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Supabase (auth + database). Required for auth, dashboard, admin.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL, used for Stripe redirect URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret for the /api/cron/* background workers (deal discovery, watchlist
# price refresh). Vercel automatically sends this as a Bearer token when it
# invokes the schedules in vercel.json, once this env var is set. Generate
# with `openssl rand -hex 32`. Hobby/free Vercel plans only allow daily cron
# — adjust vercel.json's schedule accordingly on that plan.
CRON_SECRET=

# Optional: powers the /plan AI Trip Planner's natural-language extraction
# via the Claude API. Leave blank to use the built-in rule-based extractor —
# the trip planner is fully usable without this, same as FLIGHT_PROVIDER_API_KEY.
ANTHROPIC_API_KEY=
